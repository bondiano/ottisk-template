# Переключатель модели для pnpm hello и pnpm priemka.
# bolvanka: без сети и ключа, ответы по сценарию (src/scenario.ts, priemka/scenario.ts)
# deepseek: настоящая модель, ключ с platform.deepseek.com
# openrouter, yandex, gigachat: только pnpm priemka (урок 118)
MODEL=bolvanka
DEEPSEEK_API_KEY=
# Необязательно: модель вместо deepseek-flash
DEEPSEEK_MODEL=
OPENROUTER_API_KEY=
# У OpenRouter модели по умолчанию нет, её надо назвать
OPENROUTER_MODEL=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Необязательно: модель вместо yandexgpt-5.1
YANDEX_MODEL=
# Ключ авторизации GigaChat (Base64 от Client ID и Client Secret): по нему берётся токен на 30 минут
GIGACHAT_AUTH_KEY=
# Или сразу токен доступа, если он уже есть
GIGACHAT_ACCESS_TOKEN=
