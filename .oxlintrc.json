{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "eslint/no-underscore-dangle": ["warn", { "allow": ["_tag"] }]
  },
  "ignorePatterns": [
    "litera/**",
    "priemka/api/**",
    "priemka/bolvanka*.ts",
    "priemka/contracts.ts",
    "priemka/fixtures/**",
    "src/bolvanka.ts",
    "src/reception.ts"
  ]
}
